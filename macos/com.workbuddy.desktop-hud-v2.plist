<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.workbuddy.desktop-hud-v2</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Applications/Xcode.app/Contents/Developer/usr/bin/python3</string>
        <string>-u</string>
        <string>/Users/shawn/Library/Application Support/Workbuddy Desktop HUD/host_bridge/daemon.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/shawn/Library/Application Support/Workbuddy Desktop HUD</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/shawn</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/shawn/Library/Application Support/Workbuddy Desktop HUD/.workbuddy-ai/launchagent.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/shawn/Library/Application Support/Workbuddy Desktop HUD/.workbuddy-ai/launchagent.stderr.log</string>
</dict>
</plist>
